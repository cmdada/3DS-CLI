# Linux kernel configuration for 3DS-CLI (RV32IMA + Sv32 MMU)
# Target: mini-rv32ima-mmu emulator (github.com/cmdada/mini-rv32ima-mmu)
# Toolchain: riscv32-buildroot-linux-gnu-
#
# This target used to run NOMMU (CONFIG_MMU=n), with the kernel executing
# directly in M-mode and no SBI/OpenSBI layer at all. That path hit a real,
# fundamental wall in userspace: NOMMU's ELF-FDPIC loader only accepts
# ET_DYN binaries, and glibc has zero static-PIE support on RISC-V (musl
# would have static-PIE, but this Buildroot version's musl has no RV32 port
# at all) - there was no way to produce a working init binary. The emulator
# core (see the mini-rv32ima-mmu submodule) was extended with Sv32 paging,
# S-mode, and a minimal built-in SBI instead, which sidesteps all of that:
# normal MMU'd Linux uses the standard BINFMT_ELF loader and normal dynamic
# linking, so a completely ordinary glibc RV32 toolchain works.
CONFIG_RISCV=y
# ARCH_RV32I `depends on NONPORTABLE` - without this, that choice option
# isn't visible and Kconfig silently falls back to the other one
# (ARCH_RV64I), building a 64-bit kernel our strictly-RV32 emulator core
# can't run at all (confirmed the hard way: the resulting Image's entry
# code faulted as an illegal instruction immediately, and its embedded
# image_load_offset was 0x200000, the RV64 branch's value in head.S,
# instead of RV32's 0x400000).
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y

# CONFIG_EFI's kernel entry point (arch/riscv/kernel/head.S) starts with a
# `c.li s4,-13` - a genuine 2-byte *compressed* instruction, hardcoded
# (regardless of CONFIG_RISCV_ISA_C) so the first two bytes spell "MZ" for
# UEFI's PE-header detection. mini-rv32ima-mmu doesn't implement the C
# extension at all, so it can't decode this - confirmed the hard way: the
# CPU faulted as illegal instruction on literally the first fetch. We're
# not going through real UEFI firmware (this emulator jumps straight into
# the kernel itself), so there's no EFI stub to support in the first
# place; without CONFIG_EFI, head.S's entry is instead a plain
# (non-compressed) `j _start_kernel`.
CONFIG_EFI=n

# ISA extensions supported by mini-rv32ima-mmu
CONFIG_RISCV_ISA_C=n
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_ZICSR=y
CONFIG_RISCV_ISA_ZIFENCEI=y

# Processor
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_HZ_100=y
CONFIG_HZ=100

# Memory
CONFIG_DEFAULT_MMAP_MIN_ADDR=4096
CONFIG_SLOB=y

# Executable formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# Swap. Guest RAM is whatever the 3DS heap can spare — 64MB at best, and the
# app's allocator walks down from there on Old 3DS models, so without swap
# anything substantial (a compile, several editors) just gets OOM-killed.
# Primary swap is /dev/vdb, a second virtio-blk device the app backs with
# sdmc:/swap.img (see source/virtio_blk.h). That I/O is executed natively by
# the 3DS in fread/fwrite, which is exactly why it's preferred over zram
# here: zram's compression would run on the *emulated* RV32 CPU, and it'd
# come out of the same scarce RAM pool rather than adding to it.
#
# zram is still built in as the fallback for when swap.img can't be created
# (full or read-only SD); /etc/init.d/S01swap picks whichever exists. Not a
# problem under CONFIG_SLOB below — in 6.6 ZRAM only depends on
# BLOCK && SYSFS && MMU plus a compressor, and selects ZSMALLOC itself.
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZO=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y

# Virtio
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# 9P over virtio — the transport for the 3DS-side passthrough tree (see
# source/virtio_9p.h). One virtio-9p device exports several trees, picked at
# mount time with `-o aname=`: the real SD card, the two NAND filesystems
# (read-only), and a synthetic `hw` tree for sensors/camera/mic/audio.
# 9P rather than another virtio-blk because these are host *filesystems*,
# not block images — there's no partition to hand the guest, and passing
# FAT/whatever through as blocks would mean reimplementing it twice.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=n
CONFIG_9P_FS_SECURITY=n

# Input — needed for the virtio-input device that carries the 3DS's
# accelerometer, gyroscope, and the 3D/volume sliders as a normal evdev
# node (see source/virtio_input.h). This was CONFIG_INPUT=n up until the
# guest had any real input hardware to speak of.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y

# Hardware RNG (backed by the 3DS's real hardware RNG, see virtio_rng.h)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Real-time clock (backed by the 3DS's hardware RTC, see rtc_goldfish.h)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y

# Filesystems
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# TTY / Serial
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# Networking — NAT'd out through the 3DS's WiFi by the emulator's
# virtio-net/slirp device (see source/virtio_net.h). Guest gets a DHCP
# lease on a private 10.0.2.0/24 subnet; TCP/UDP/DNS work, ICMP to the
# gateway (10.0.2.2) works as a reachability check, ICMP to other hosts
# does not (no raw sockets available to homebrew).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_PNP=n
CONFIG_NETDEVICES=y

# Disable unused drivers
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_GPU_DRM=n
CONFIG_FRAMEBUFFER_CONSOLE=n
# VGA_CONSOLE defaults to y on RISC-V (its Kconfig guard excludes several
# archs but not riscv) yet riscv never defines the `screen_info` struct
# vgacon.c links against, so it fails at the final link step. Not needed
# anyway — this machine has no VGA hardware and boots through the serial
# console (ns16850 uart).
CONFIG_VGA_CONSOLE=n

# Power management
CONFIG_PM=n

# Independent IRQ/softirq stacks (arch/riscv/kernel/irq.c) switch to a
# separate per-cpu stack region while handling interrupts. Left disabled
# since it's one less moving part and a supported, intentional option (see
# "may save memory footprint by disabling IRQ_STACKS" in its own help
# text), not a hack. IRQ_STACKS' prompt is "bool ... if EXPERT" — without
# CONFIG_EXPERT=y the symbol is invisible to Kconfig and silently reverts
# to its y default no matter what we write here.
CONFIG_EXPERT=y
CONFIG_IRQ_STACKS=n

# Debug info for addr2line during bring-up/bisection. Costs ~10x vmlinux
# size — drop once the MMU port is stable, not something to ship.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# die() falls through to make_task_dead() when this is unset, which isn't
# a guaranteed halt; PANIC_ON_OOPS makes any oops that reaches die() a
# clean, deterministic panic instead.
CONFIG_PANIC_ON_OOPS=y

# initrd/initramfs — NOT used; rootfs is on virtio-blk
CONFIG_BLK_DEV_INITRD=n
