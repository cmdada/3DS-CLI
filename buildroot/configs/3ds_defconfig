# Target: RISC-V 32-bit, no MMU, ILP32 ABI (integer-only: mini-rv32ima
# implements RV32IMA only, no F/D/C extensions). The default "G" (IMAFD)
# architecture variant silently won here before because BR2_riscv_abi_ilp32
# isn't a real Kconfig symbol (correct name is BR2_RISCV_ABI_ILP32, and the
# ISA variant choice needs BR2_riscv_custom instead of the BR2_riscv_g
# default) - userspace binaries built with hardware float/double
# instructions then took SIGILL on first FP use, e.g. /sbin/init crashing
# immediately after rootfs mount.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_32=y
BR2_RISCV_ABI_ILP32=y

# Internal toolchain: glibc (the choice default - uClibc-ng has no RISC-V
# port at all in this Buildroot version).
#
# This target used to run NOMMU, which turned into a real dead end for
# userspace: the kernel's NOMMU mmap() can't do the demand-paged
# copy-on-write mappings ELF shared libraries need (dynamic linking failed
# outright), and NOMMU's ELF-FDPIC loader only accepts ET_DYN, which for a
# *static* binary means static-PIE - glibc has zero static-PIE support on
# RISC-V, and this Buildroot version's musl has no RISC-V 32-bit port at
# all either. Rather than patching glibc or waiting on musl upstream, the
# emulator core itself (see the mini-rv32ima-mmu submodule) was extended
# with real Sv32 paging, S-mode, and a minimal built-in SBI. With a real
# MMU, none of the above applies: normal BINFMT_ELF handles ordinary
# dynamically-linked ET_EXEC binaries the standard way, so this is just a
# completely unremarkable glibc RV32 target now.
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_14_X=y

# Kernel (custom config — see board/3ds-cli/linux.config)
# (Tried the 5.10 CIP LTS branch to rule out a 6.6-specific regression in
# the boot hang below, but 5.10's arch/riscv/Kconfig unconditionally does
# `select MMU` from ARCH_RV32I — RV32 NOMMU/M-mode support plain doesn't
# exist that far back, so it's not usable here at all. Back on 6.6.63.)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_3DS_CLI_PATH)/board/3ds-cli/linux.config"
BR2_LINUX_KERNEL_IMAGE_NAME="Image"
BR2_LINUX_KERNEL_INSTALL_TARGET=n

# Build system
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_3DS_CLI_PATH)/board/3ds-cli/rootfs_overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_3DS_CLI_PATH)/board/3ds-cli/post_image.sh"

# Core userspace
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Better shell
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y

# System monitoring
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_PROCPS_NG=y

# Terminal / ncurses (needed by htop, nano)
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_TARGET_HEADERS=y

# Text editors
BR2_PACKAGE_NANO=y
BR2_PACKAGE_VIM=y

# Fun / system info
BR2_PACKAGE_NEOFETCH=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# Networking — talks out through the emulator's virtio-net/slirp NAT
# device (see source/virtio_net.h), which bridges to the 3DS's real WiFi.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_WGET=y

# Filesystem support in host tools
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
